<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>org.featuresliced.steiger</id>
    <name>Steiger</name>

    <vendor url="https://github.com/feature-sliced">FeatureSliced</vendor>

    <description><![CDATA[
        Integrates the <a href="https://github.com/feature-sliced/steiger">steiger</a> linter
        via the Language Server Protocol.<br>
        Highlights project architecture violations reported by steiger directly in the editor.
        ]]></description>
    <!-- LSP API module: present in all commercial JetBrains IDEs, absent in IDEA CE / Android Studio -->
    <depends>com.intellij.modules.lsp</depends>
    <!-- Optional: enables the run-configuration-style Node interpreter selector -->
    <depends optional="true" config-file="steiger-js.xml">JavaScript</depends>

    <extensionPoints>
        <extensionPoint name="settingsUi"
                        interface="org.featuresliced.steiger.settings.SteigerSettingsUi"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
                implementation="org.featuresliced.steiger.lsp.SteigerLspServerSupportProvider"/>

        <projectConfigurable
                groupId="tools"
                id="steiger"
                displayName="Steiger"
                nonDefaultProject="true"
                instance="org.featuresliced.steiger.settings.SteigerConfigurable"/>
    </extensions>

</idea-plugin>
